{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup",
      "type": "shell",
      "command": "scripts/setup",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Develop (start HA)",
      "type": "shell",
      "command": "scripts/develop",
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Home Assistant",
          "endsPattern": "Home Assistant initialized"
        }
      }
    },
    {
      "label": "Lint & format",
      "type": "shell",
      "command": "scripts/lint",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "pytest — all tests",
      "type": "shell",
      "command": "python3 -m pytest tests/ -v",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "pytest — with coverage",
      "type": "shell",
      "command": "python3 -m pytest tests/ -v --cov=custom_components/opcua_server --cov-report=html",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
